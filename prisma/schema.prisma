datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  ADMIN
  FINANCE
  OPERATIONS
  MARKETING
  APPROVER
  VIEWER
  CONTRIBUTOR
  PARTNER
}

enum TransactionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REVERSED
  CANCELLED
}

enum LineType {
  DEBIT
  CREDIT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  TRANSFER
  WASTAGE
  ADJUSTMENT
}

enum MovementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnerTxnType {
  CAPITAL_INTRODUCED
  LOAN_GIVEN
  LOAN_REPAYMENT
  REIMBURSEMENT
  WITHDRAWAL
  OTHER
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DISPOSED
  WRITTEN_OFF
}

enum ImportJobStatus {
  UPLOADED
  MAPPING
  VALIDATING
  REVIEWING
  APPROVED
  POSTING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALID
  ERROR
  DUPLICATE
  POSTED
}

model Company {
  id                 String              @id @default(cuid())
  name               String
  gstin              String?
  financialYearStart Int                 @default(4)
  address            String?
  city               String?
  state              String?
  phone              String?
  email              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  members            CompanyMember[]
  partners           Partner[]
  accounts           Account[]
  products           Product[]
  orders             Order[]
  transactions       Transaction[]
  assets             Asset[]
  adAccounts         AdAccount[]
  forecastScenarios  ForecastScenario[]
  importJobs         ImportJob[]
  auditLogs          AuditLog[]
  taxCodes           TaxCode[]
  customers          Customer[]
  salesChannels      SalesChannel[]
  inventoryLocations InventoryLocation[]
  parties            Party[]
  productCategories  ProductCategory[]
  partnerCapitals    PartnerCapital[]
  payments           Payment[]
  returns            Return[]
  inventoryMovements InventoryMovement[]
  depreciationEntries DepreciationEntry[]
  campaigns          Campaign[]
  adPerformanceDaily AdPerformanceDaily[]
  orderAttributions  OrderAttribution[]
  customerFeedbacks  CustomerFeedback[]

  @@index([name])
  @@index([gstin])
  @@index([createdAt])
  @@map("companies")
}

model AppUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String?
  mfaEnabled   Boolean         @default(false)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  memberships  CompanyMember[]
  auditLogs    AuditLog[]

  @@index([name])
  @@index([isActive])
  @@index([createdAt])
  @@map("app_users")
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
  @@map("company_members")
}

model Partner {
  id             String           @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  capitalEntries PartnerCapital[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@map("partners")
}

model PartnerCapital {
  id            String         @id @default(cuid())
  companyId     String
  partnerId     String
  date          DateTime
  amountPaise   Int
  type          PartnerTxnType
  reason        String
  paymentMethod String?
  reference     String?
  evidenceUrl   String?
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([companyId, partnerId])
  @@index([companyId, date])
  @@index([companyId])
  @@index([partnerId])
  @@index([date])
  @@index([type])
  @@index([amountPaise])
  @@index([createdBy])
  @@index([createdAt])
  @@map("partner_capitals")
}

model Account {
  id          String            @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        String
  parentId    String?
  isActive    Boolean           @default(true)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Account?          @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]         @relation("AccountHierarchy")
  lines       TransactionLine[]
  payments    Payment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([code])
  @@index([name])
  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@map("accounts")
}

model Transaction {
  id            String            @id @default(cuid())
  companyId     String
  date          DateTime
  reference     String?
  description   String
  status        TransactionStatus @default(DRAFT)
  submittedBy   String?
  submittedAt   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  postedBy      String?
  postedAt      DateTime?
  reversedBy    String?
  reversedAt    DateTime?
  reversalOfId  String?           @unique
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines         TransactionLine[]
  reversalOf    Transaction?      @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversalEntry Transaction?      @relation("TransactionReversal")
  allocations   PaymentAllocation[]

  @@index([companyId, date])
  @@index([companyId, status])
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@index([reference])
  @@index([createdBy])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionLine {
  id            String      @id @default(cuid())
  transactionId String
  accountId     String
  type          LineType
  amountPaise   Int
  description   String?
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@index([accountId, type])
  @@index([type])
  @@index([amountPaise])
  @@index([createdAt])
  @@map("transaction_lines")
}

model Party {
  id        String    @id @default(cuid())
  companyId String
  name      String
  type      String
  gstin     String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments  Payment[]
  assets    Asset[]

  @@index([companyId, type])
  @@index([companyId])
  @@index([name])
  @@index([type])
  @@index([gstin])
  @@index([phone])
  @@index([email])
  @@index([isActive])
  @@map("parties")
}

model Payment {
  id            String              @id @default(cuid())
  companyId     String
  date          DateTime
  partyId       String?
  accountId     String
  amountPaise   Int
  type          String
  method        String
  reference     String?
  description   String?
  evidenceUrl   String?
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party         Party?              @relation(fields: [partyId], references: [id], onDelete: SetNull)
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]

  @@index([companyId, date])
  @@index([companyId])
  @@index([date])
  @@index([partyId])
  @@index([accountId])
  @@index([type])
  @@index([method])
  @@index([reference])
  @@index([createdBy])
  @@index([createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id            String       @id @default(cuid())
  paymentId     String
  transactionId String?
  orderId       String?
  amountPaise   Int
  createdAt     DateTime     @default(now())

  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([transactionId])
  @@index([orderId])
  @@map("payment_allocations")
}

model TaxCode {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  hsnSac        String?
  cgstRate      Float
  sgstRate      Float
  igstRate      Float
  cessRate      Float       @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products      Product[]

  @@unique([companyId, name, effectiveFrom])
  @@index([companyId])
  @@index([name])
  @@index([hsnSac])
  @@index([isActive])
  @@map("tax_codes")
}

model ProductCategory {
  id        String            @id @default(cuid())
  companyId String
  name      String
  parentId  String?
  createdAt DateTime          @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  products  Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id                String              @id @default(cuid())
  companyId         String
  sku               String
  name              String
  categoryId        String?
  unit              String              @default("PCS")
  hsnCode           String?
  taxCodeId         String?
  costPricePaise    Int                 @default(0)
  sellingPricePaise Int                 @default(0)
  reorderLevel      Int                 @default(0)
  isActive          Boolean             @default(true)
  description       String?
  imageUrl          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category          ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxCode           TaxCode?            @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)
  orderLines        OrderLine[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId])
  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@index([taxCodeId])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model SalesChannel {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([name])
  @@index([isActive])
  @@map("sales_channels")
}

model Customer {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  phone          String?
  email          String?
  city           String?
  address        String?
  source         String?
  firstPurchaseAt DateTime?
  lastPurchaseAt DateTime?
  orderCount     Int       @default(0)
  totalSpentPaise Int      @default(0)
  notes          String?
  consentStatus  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([companyId, phone])
  @@index([companyId, email])
  @@index([companyId])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([city])
  @@index([source])
  @@index([orderCount])
  @@index([totalSpentPaise])
  @@index([createdAt])
  @@index([lastPurchaseAt])
  @@map("customers")
}

model Order {
  id             String              @id @default(cuid())
  companyId      String
  orderNumber    String
  channelId      String
  customerId     String?
  date           DateTime
  status         OrderStatus         @default(DRAFT)
  subtotalPaise  Int
  discountPaise  Int                 @default(0)
  taxPaise       Int                 @default(0)
  totalPaise     Int
  notes          String?
  externalRef    String?
  invoiceNumber  String?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel        SalesChannel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines          OrderLine[]
  returns        Return[]
  allocations    PaymentAllocation[]
  attributions   OrderAttribution[]

  @@unique([companyId, orderNumber])
  @@index([companyId, date])
  @@index([companyId, status])
  @@index([companyId])
  @@index([orderNumber])
  @@index([channelId])
  @@index([customerId])
  @@index([date])
  @@index([status])
  @@index([totalPaise])
  @@index([createdBy])
  @@index([createdAt])
  @@map("orders")
}

model OrderLine {
  id                 String       @id @default(cuid())
  orderId            String
  productId          String
  quantity           Int
  unitPricePaise     Int
  discountPaise      Int          @default(0)
  taxableAmountPaise Int
  cgstPaise          Int          @default(0)
  sgstPaise          Int          @default(0)
  igstPaise          Int          @default(0)
  cessPaise          Int          @default(0)
  totalPaise         Int
  hsnCode            String?
  placeOfSupply      String?
  createdAt          DateTime     @default(now())

  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnLines        ReturnLine[]

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
  @@map("order_lines")
}

model Return {
  id                String       @id @default(cuid())
  companyId         String
  orderId           String
  date              DateTime
  status            ReturnStatus @default(REQUESTED)
  reason            String?
  refundAmountPaise Int          @default(0)
  restockQuantity   Int          @default(0)
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines             ReturnLine[]

  @@index([companyId])
  @@index([orderId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("returns")
}

model ReturnLine {
  id           String    @id @default(cuid())
  returnId     String
  orderLineId  String
  quantity     Int
  reason       String?
  isRestockable Boolean  @default(true)
  createdAt    DateTime  @default(now())

  return       Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine    OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([orderLineId])
  @@map("return_lines")
}

model InventoryLocation {
  id        String              @id @default(cuid())
  companyId String
  name      String
  address   String?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([name])
  @@index([isActive])
  @@map("inventory_locations")
}

model InventoryMovement {
  id             String          @id @default(cuid())
  companyId      String
  productId      String
  locationId     String
  type           MovementType
  status         MovementStatus  @default(PENDING)
  quantity       Int
  costPricePaise Int             @default(0)
  reference      String?
  reason         String?
  orderId        String?
  returnId       String?
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String
  createdAt      DateTime        @default(now())

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location       InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([companyId, productId])
  @@index([companyId, productId, status])
  @@index([companyId, type])
  @@index([companyId])
  @@index([productId])
  @@index([locationId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Asset {
  id                    String              @id @default(cuid())
  companyId             String
  name                  String
  category              String?
  supplierId            String?
  invoiceNumber         String?
  purchaseDate          DateTime
  acquisitionCostPaise  Int
  installationCostPaise Int                 @default(0)
  serialNumber          String?
  warrantyExpiry        DateTime?
  location              String?
  status                AssetStatus         @default(ACTIVE)
  usefulLifeMonths      Int?
  residualValuePaise    Int                 @default(0)
  depreciationMethod    String              @default("STRAIGHT_LINE")
  notes                 String?
  createdBy             String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier              Party?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  events                AssetEvent[]
  depreciationEntries   DepreciationEntry[]

  @@index([companyId, status])
  @@index([companyId])
  @@index([name])
  @@index([category])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseDate])
  @@index([createdAt])
  @@map("assets")
}

model AssetEvent {
  id          String   @id @default(cuid())
  assetId     String
  date        DateTime
  type        String
  description String
  costPaise   Int      @default(0)
  evidenceUrl String?
  createdBy   String
  createdAt   DateTime @default(now())

  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([date])
  @@index([type])
  @@map("asset_events")
}

model DepreciationEntry {
  id               String   @id @default(cuid())
  companyId        String
  assetId          String
  periodStart      DateTime
  periodEnd        DateTime
  amountPaise      Int
  accumulatedPaise Int
  bookValuePaise   Int
  createdAt        DateTime @default(now())

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, periodStart])
  @@index([companyId])
  @@index([assetId])
  @@index([periodStart])
  @@map("depreciation_entries")
}

model AdAccount {
  id          String      @id @default(cuid())
  companyId   String
  platform    String
  accountName String
  externalId  String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@unique([companyId, platform, externalId])
  @@index([companyId])
  @@index([platform])
  @@index([isActive])
  @@map("ad_accounts")
}

model Campaign {
  id           String               @id @default(cuid())
  companyId    String
  adAccountId  String
  name         String
  externalId   String?
  status       String               @default("ACTIVE")
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adAccount    AdAccount            @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  performances AdPerformanceDaily[]
  attributions OrderAttribution[]

  @@index([companyId])
  @@index([adAccountId])
  @@index([name])
  @@index([status])
  @@index([startDate])
  @@map("campaigns")
}

model AdPerformanceDaily {
  id                   String   @id @default(cuid())
  companyId            String
  campaignId           String
  date                 DateTime
  spendPaise           Int      @default(0)
  impressions          Int      @default(0)
  clicks               Int      @default(0)
  conversions          Int      @default(0)
  platformRevenuePaise Int      @default(0)
  createdAt            DateTime @default(now())

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([companyId])
  @@index([campaignId])
  @@index([date])
  @@map("ad_performance_daily")
}

model OrderAttribution {
  id                    String   @id @default(cuid())
  companyId             String
  orderId               String
  campaignId            String
  model                 String   @default("LAST_CLICK")
  window                String   @default("7D")
  attributedRevenuePaise Int
  createdAt             DateTime @default(now())

  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  campaign              Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderId])
  @@index([campaignId])
  @@map("order_attributions")
}

model ImportJob {
  id            String          @id @default(cuid())
  companyId     String
  entityType    String
  fileName      String
  fileHash      String?
  totalRows     Int             @default(0)
  validRows     Int             @default(0)
  errorRows     Int             @default(0)
  duplicateRows Int             @default(0)
  status        ImportJobStatus @default(UPLOADED)
  columnMapping Json?
  approvedBy    String?
  approvedAt    DateTime?
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rows          ImportRow[]

  @@index([companyId, status])
  @@index([companyId])
  @@index([status])
  @@index([entityType])
  @@index([createdAt])
  @@map("import_jobs")
}

model ImportRow {
  id               String          @id @default(cuid())
  importJobId      String
  rowNumber        Int
  rawData          Json
  normalizedData   Json?
  validationErrors Json?
  status           ImportRowStatus @default(PENDING)
  postingRef       String?
  createdAt        DateTime        @default(now())

  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, status])
  @@index([importJobId])
  @@index([status])
  @@index([rowNumber])
  @@map("import_rows")
}

model ForecastScenario {
  id            String          @id @default(cuid())
  companyId     String
  name          String
  type          String
  horizonMonths Int             @default(12)
  assumptions   Json?
  version       Int             @default(1)
  isActive      Boolean         @default(true)
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  months        ForecastMonth[]

  @@index([companyId])
  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("forecast_scenarios")
}

model ForecastMonth {
  id                 String           @id @default(cuid())
  scenarioId         String
  month              DateTime
  unitsSold          Int              @default(0)
  revenuePaise       Int              @default(0)
  cogsPaise          Int              @default(0)
  adSpendPaise       Int              @default(0)
  fixedCostsPaise    Int              @default(0)
  capexPaise         Int              @default(0)
  receivablesPaise   Int              @default(0)
  payablesPaise      Int              @default(0)
  gstPayablePaise    Int              @default(0)
  netCashFlowPaise   Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  scenario           ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, month])
  @@index([scenarioId])
  @@index([month])
  @@map("forecast_months")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CustomerFeedback {
  id                  String   @id @default(cuid())
  companyId           String   @default("vedro-company-main")
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  city                String?

  // The 8 customer feedback questions:
  overallQuality      String   // Excellent | Good | Average | Poor | Very Poor
  naturalAroma        String   // Very Satisfied | Satisfied | Neutral | Dissatisfied | Very Dissatisfied
  tasteAndFlavour     String   // Excellent | Good | Average | Poor | Very Poor
  colourTexture       String   // Very Satisfied | Satisfied | Neutral | Dissatisfied | Very Dissatisfied
  cookingPerformance  String   // Excellent | Good | Average | Poor | Very Poor
  packagingQuality    String   // Very Satisfied | Satisfied | Neutral | Dissatisfied | Very Dissatisfied
  issuesNoticed       String   // No issues | Aroma or taste | Colour or consistency | Packaging or leakage | Other
  issuesDetails       String?
  repurchaseRecommend String   // Definitely | Probably | Not Sure | Probably Not | Definitely Not

  additionalComments  String?
  source              String   @default("WEB_FORM")
  createdAt           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("customer_feedbacks")
}
