# ==============================================================================
# Vedro Business Dashboard Environment Variables (Template)
# ==============================================================================

# 1. Neon PostgreSQL Database Connection URL
# Use your pooled connection string from Neon Console
DATABASE_URL="postgresql://username:password@ep-your-pooler.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth Canonical URL
# Set to your domain in production, or http://localhost:3000 locally
NEXTAUTH_URL="http://localhost:3000"

# 3. NextAuth Encryption Secret
# Generate a strong 32+ character random string (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret-key"

# 4. Partner & Admin Initial Default Password (Optional)
ADMIN_PASSWORD="your-strong-partner-password"
